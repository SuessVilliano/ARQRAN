# Public browser settings
VITE_PUBLIC_AR_BASE_URL=https://arqran.liv8.co
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Serverless-only secrets — never prefix these with VITE_
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_ASSET_BUCKET=ar-assets
SQR_API_BASE_URL=https://sqr.co/api
SQR_API_KEY=YOUR_SQR_API_KEY
SQR_PROJECT_ID=
SQR_DOMAIN_ID=

# Configure scan.liv8.co inside SQR and put its domain ID in SQR_DOMAIN_ID.
# Vercel app: arqran.liv8.co
# Branded scan/redirect domain: scan.liv8.co
