# Public browser settings
VITE_PUBLIC_AR_BASE_URL=https://arqran.liv8.co
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
VITE_GOOGLE_MAPS_API_KEY=YOUR_BROWSER_RESTRICTED_GOOGLE_MAPS_KEY

# Serverless-only secrets — never prefix these with VITE_
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_ASSET_BUCKET=ar-assets
SQR_API_BASE_URL=https://sqr.co/api
SQR_API_KEY=YOUR_SQR_API_KEY
SQR_PROJECT_ID=
SQR_DOMAIN_ID=
SQR_SCAN_HOST=scan.liv8.co
OPENAI_API_KEY=YOUR_SERVER_SIDE_OPENAI_KEY
OPENAI_MODEL=gpt-5.6-luna

# If SQR_DOMAIN_ID is blank, ARQRAN attempts to discover scan.liv8.co through the SQR domains API.
# Restrict VITE_GOOGLE_MAPS_API_KEY to arqran.liv8.co in Google Cloud; it is intentionally browser-visible.
# Vercel app: arqran.liv8.co
# Branded scan/redirect domain: scan.liv8.co
